# =============================================================================
# TataDana — Indonesian Personal Finance SaaS & Telegram Bot
# Comprehensive Environment Configuration Template
# =============================================================================
# Instructions:
# 1. Copy this file to .env (or .env.local):
#    cp .env.example .env
# 2. Fill in the values for your environment.
# 3. For offline testing or zero-credential development, set:
#    MOCK_SUPABASE=true
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# -----------------------------------------------------------------------------
# Current environment: 'development', 'test', or 'production'
NODE_ENV=development

# Port where Remix / React Router application server will listen
PORT=3000

# Canonical public application URL (used for OAuth redirects, webhooks & exports)
APP_URL=http://localhost:3000

# Cryptographically strong secret key used to sign HTTP session cookies (min 32 chars)
SESSION_SECRET=tatadana-ultra-secure-random-session-secret-key-32-chars-min

# -----------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTH (BACKEND & SERVER-SIDE)
# -----------------------------------------------------------------------------
# Supabase project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase public anonymous API key (safe for client-side queries with RLS)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Supabase Service Role secret key (bypasses RLS, NEVER expose to client-side)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# -----------------------------------------------------------------------------
# 3. SUPABASE PUBLIC CLIENT VARIABLES (VITE / FRONTEND)
# -----------------------------------------------------------------------------
# Publicly accessible Supabase credentials used during browser runtime hydration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# -----------------------------------------------------------------------------
# 4. SUPABASE STORAGE BUCKETS
# -----------------------------------------------------------------------------
# Private bucket for user uploaded receipt photos (accessed via signed URLs)
SUPABASE_STORAGE_BUCKET_RECEIPTS=receipts

# Private bucket for generated PDF and Excel (.xlsx) financial reports (ephemeral signed URLs)
SUPABASE_STORAGE_BUCKET_EXPORTS=reports

# -----------------------------------------------------------------------------
# 5. TELEGRAM BOT INTEGRATION (R2)
# -----------------------------------------------------------------------------
# Telegram Bot Token obtained from @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_your_bot_token

# Telegram Bot username without @ symbol (e.g. TataDanaBot)
TELEGRAM_BOT_USERNAME=TataDanaBot

# Secret header token passed in X-Telegram-Bot-Api-Secret-Token for webhook verification
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_phrase_min_16_chars

# -----------------------------------------------------------------------------
# 6. MULTIMODAL AI PROVIDERS (R2, R4)
# -----------------------------------------------------------------------------
# Google Gemini API Key (Baseline engine for natural language, OCR vision, & VN audio)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# OpenAI API Key (Failover LLM for GPT-4o-mini & Whisper audio transcription)
OPENAI_API_KEY=sk_your_openai_api_key_here

# DeepSeek API Key (Alternative cost-effective LLM provider for text parsing)
DEEPSEEK_API_KEY=sk_your_deepseek_api_key_here

# Default active AI provider: 'gemini', 'openai', or 'deepseek'
AI_DEFAULT_PROVIDER=gemini

# AI Execution Mode configured by Superadmin: 'single', 'parallel', or 'fallback'
AI_EXECUTION_MODE=single

# Timeout in milliseconds for AI model parsing calls before triggering fallback
AI_TIMEOUT_MS=8000

# -----------------------------------------------------------------------------
# 7. MIDTRANS PAYMENT GATEWAY (R4)
# -----------------------------------------------------------------------------
# Midtrans Server Key (e.g. SB-Mid-server-xxxx for Sandbox)
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key-here

# Midtrans Client Key (e.g. SB-Mid-client-xxxx for Sandbox)
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key-here

# Midtrans Environment toggle: true for production, false for sandbox
MIDTRANS_IS_PRODUCTION=false

# Optional Midtrans Merchant ID
MIDTRANS_MERCHANT_ID=G123456789

# -----------------------------------------------------------------------------
# 8. SMS OTP VERIFICATION (R1, R5)
# -----------------------------------------------------------------------------
# SMS Provider for Indonesian phone OTP: 'twilio' or 'zenziva' or 'mock'
SMS_OTP_PROVIDER=mock

# Twilio Account SID (if using Twilio)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here

# Twilio Auth Token (if using Twilio)
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio Sender Phone Number in E.164 format (+1xxxxxxxxxx)
TWILIO_PHONE_NUMBER=+12025550123

# Allow test sandbox bypass: when true, verification accepts OTP '123456'
SMS_OTP_MOCK_ENABLED=true

# -----------------------------------------------------------------------------
# 9. TESTING, SANDBOX & OFFLINE EMULATION
# -----------------------------------------------------------------------------
# Enable full in-memory Supabase mock client (ideal for offline tests, CI/CD, and demo runs)
MOCK_SUPABASE=false

# Auto-seed sandbox test accounts and transactions on initial startup
SEED_SANDBOX_DATA=true

# -----------------------------------------------------------------------------
# 10. SUPERADMIN INITIAL CREDENTIALS (M1 SEEDING)
# -----------------------------------------------------------------------------
# Default email address assigned with superadmin privileges
ADMIN_EMAIL=halidanazla10@gmail.com

# Initial temporary password for admin setup (change immediately upon deployment)
ADMIN_INITIAL_PASSWORD=HalidaTataDana2026!

# Admin provisioning token for secure administrative setup
ADMIN_SETUP_TOKEN=TataDanaAdminTokenSecure2026!
